# ---------------- SUSPICIOUS IPS ---------------- #

suspicious_ips = [
    "45.33.32.156",
    "8.8.8.8"
]

# ---------------- BUTTON FUNCTIONS ---------------- #

def start_monitoring():

    global running

    running = True

    status_box.config(
        text="STATUS\nRUNNING",
        fg="#00ff00",
        highlightbackground="#00ff00"
    )

    terminal.insert(
        END,
        "\n> Monitoring Started...\n"
    )

def stop_monitoring():

    global running

    running = False

    status_box.config(
        text="STATUS\nSTOPPED",
        fg="red",
        highlightbackground="red"
    )

    terminal.insert(
        END,
        "\n> Monitoring Stopped...\n"
    )

def continue_monitoring():

    global running

    running = True

    status_box.config(
        text="STATUS\nRUNNING",
        fg="#00ff00",
        highlightbackground="#00ff00"
    )

    terminal.insert(
        END,
        "\n> Monitoring Continued...\n"
    )

# RESTART FUNCTION
def restart_monitoring():

    global running
    global packet_count
    global alert_count

    running = False

    packet_count = 0
    alert_count = 0

    packet_box.config(
        text="TOTAL PACKETS\n0"
    )

    alert_box.config(
        text="ALERTS\n0"
    )

    output.delete(1.0, END)

    terminal.insert(
        END,
        "\n> System Restarted...\n"
    )

    running = True

    status_box.config(
        text="STATUS\nRUNNING",
        fg="#00ff00",
        highlightbackground="#00ff00"
    )

# CLEAR SCREEN
def clear_screen():

    output.delete(1.0, END)

    terminal.insert(
        END,
        "\n> Screen Cleared...\n"
    )

# EXIT PROGRAM
def exit_program():

    terminal.insert(
        END,
        "\n> Exiting System...\n"
    )

    root.destroy()

# CONNECT BUTTONS
start_button.config(command=start_monitoring)
stop_button.config(command=stop_monitoring)
continue_button.config(command=continue_monitoring)
restart_button.config(command=restart_monitoring)
clear_button.config(command=clear_screen)
exit_button.config(command=exit_program)

# ---------------- PACKET FUNCTION ---------------- #

def show_packet(packet):

    global packet_count
    global alert_count

    if running:

        if packet.haslayer(IP):

            packet_count += 1

            src = packet[IP].src
            dst = packet[IP].dst
            proto = packet[IP].proto

            current_time = datetime.now().strftime("%H:%M:%S")

            data = f"""
========================================
TIME : {current_time}

SOURCE IP      : {src}
DESTINATION IP : {dst}
PROTOCOL       : {proto}

========================================
"""

            # SHOW IN GUI
            output.insert(END, data)
            output.see(END)

            # UPDATE COUNTER
            packet_box.config(
                text=f"TOTAL PACKETS\n{packet_count}"
            )

            # SAVE LOGS
            with open("sniff.logs", "a") as logfile:
                logfile.write(data)

            # ALERT SYSTEM
            if src in suspicious_ips:

                alert_count += 1

                alert_box.config(
                    text=f"ALERTS\n{alert_count}"
                )

                warning = f"""

[WARNING] Suspicious IP Detected
IP : {src}

"""

                output.insert(END, warning)

                terminal.insert(
                    END,
                    f"\n> ALERT DETECTED FROM {src}\n"
                )

                # SAVE ALERTS
                with open("sniff.logs", "a") as logfile:
                    logfile.write(warning)

# ---------------- SNIFF FUNCTION ---------------- #

def sniff_packets():

    sniff(
        prn=show_packet,
        store=False
    )

# ---------------- THREAD ---------------- #

thread = threading.Thread(
    target=sniff_packets
)

thread.daemon = True
thread.start()

# ---------------- RUN APP ---------------- #

root.mainloop()
